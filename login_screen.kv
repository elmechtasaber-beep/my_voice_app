<LoginScreen>:
    email_input: email_field
    password_input: password_field

    FloatLayout:
        Image:
            source: "login_background.png"
            allow_stretch: True
            keep_ratio: False
            size: self.parent.size
            pos: self.parent.pos

        BoxLayout:
            orientation: "vertical"
            padding: "24dp"
            spacing: "12dp"
            size_hint: 0.88, 0.70
            pos_hint: {"center_x": 0.5, "center_y": 0.50}
            canvas.before:
                Color:
                    rgba: 0, 0, 0, 0.48
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [18]

            Widget:
                size_hint_y: 0.10

            Label:
                text: "SAR VOC"
                font_size: "30sp"
                bold: True
                color: 1, 1, 1, 1
                size_hint_y: None
                height: "50dp"

            Label:
                text: "تسجيل الدخول"
                font_size: "22sp"
                bold: True
                color: 1, 1, 1, 1
                size_hint_y: None
                height: "40dp"

            TextInput:
                id: email_field
                hint_text: "الإيميل"
                multiline: False
                size_hint_y: None
                height: "45dp"

            TextInput:
                id: password_field
                hint_text: "كلمة السر"
                password: True
                multiline: False
                size_hint_y: None
                height: "45dp"

            Button:
                text: "دخول"
                size_hint_y: None
                height: "45dp"
                on_release: root.login(email_field.text, password_field.text)

            Button:
                text: "إنشاء حساب جديد"
                size_hint_y: None
                height: "45dp"
                on_release: root.sign_up(email_field.text, password_field.text)

            Widget:
                size_hint_y: 0.12
