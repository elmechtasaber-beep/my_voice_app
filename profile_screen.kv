<ProfileScreen>:
    BoxLayout:
        orientation: "vertical"
        padding: "14dp"
        spacing: "10dp"
        canvas.before:
            Color:
                rgba: .965, .965, .975, 1
            Rectangle:
                pos: self.pos
                size: self.size

        BoxLayout:
            size_hint_y: None
            height: "45dp"
            Label:
                text: "البروفايل"
                font_size: "23sp"
                bold: True
                color: .08,.08,.1,1
            Button:
                text: "رجوع"
                size_hint_x: None
                width: "80dp"
                on_release: root.go_back()

        BoxLayout:
            size_hint_y: None
            height: "48dp"
            spacing: "8dp"
            Image:
                id: vip_badge
                opacity: 0
                size_hint_x: None
                width: "90dp"
                allow_stretch: True
            Label:
                id: vip_label
                text: ""
                bold: True
                color: .85,.65,.15,1
                size_hint_x: None
                width: "70dp"

        Label:
            text: "البريد الإلكتروني"
            font_size: "13sp"
            color: .35,.35,.38,1
            size_hint_y: None
            height: "22dp"
            halign: "left"
            text_size: self.size

        Label:
            id: email_label
            text: ""
            font_size: "15sp"
            color: .12,.12,.14,1
            size_hint_y: None
            height: "28dp"
            halign: "left"
            text_size: self.size

        Label:
            text: "الاسم المعروض"
            font_size: "13sp"
            color: .35,.35,.38,1
            size_hint_y: None
            height: "22dp"
            halign: "left"
            text_size: self.size

        TextInput:
            id: username_input
            multiline: False
            size_hint_y: None
            height: "45dp"

        Button:
            text: "حفظ التغييرات"
            size_hint_y: None
            height: "45dp"
            on_release: root.save_username()

        Widget:
