import random
import json
from kivy.app import App
from kivy.uix.boxlayout import BoxLayout
from kivy.uix.gridlayout import GridLayout
from kivy.uix.label import Label
from kivy.uix.textinput import TextInput
from kivy.uix.button import Button
from kivy.uix.popup import Popup
from kivy.uix.screenmanager import ScreenManager, Screen

DATA_FILE = "user_data.json"

def load_data():
    try:
        with open(DATA_FILE, "r", encoding="utf-8") as f:
            return json.load(f)
    except:
        return {"user_name": "زائر", "coins": 5000, "is_logged_in": False}

def save_data(data):
    with open(DATA_FILE, "w", encoding="utf-8") as f:
        json.dump(data, f)

# ----------------- 1. شاشة تسجيل الدخول -----------------
class LoginScreen(Screen):
    def __init__(self, **kwargs):
        super().__init__(**kwargs)
        layout = BoxLayout(orientation='vertical', padding=25, spacing=15)
        
        layout.add_widget(Label(text="[b]🔑 تسجيل الدخول للتطبيق[/b]", markup=True, font_size='22sp'))
        
        self.username_input = TextInput(hint_text="أدخل اسم المستخدم أو البريد الإلكتروني", multiline=False, size_hint_y=0.2)
        layout.add_widget(self.username_input)
        
        btn_google = Button(text="🌐 دخول باستخدام Google", background_color=(0.8, 0.2, 0.2, 1), size_hint_y=0.2)
        btn_google.bind(on_press=self.login_action)
        layout.add_widget(btn_google)
        
        btn_guest = Button(text="👤 دخول كـ زائر", background_color=(0.3, 0.5, 0.8, 1), size_hint_y=0.2)
        btn_guest.bind(on_press=self.guest_action)
        layout.add_widget(btn_guest)
        
        self.add_widget(layout)

    def login_action(self, instance):
        name = self.username_input.text.strip() or "حساب Google"
        data = load_data()
        data["user_name"] = name
        data["is_logged_in"] = True
        save_data(data)
        self.manager.current = 'main_menu'

    def guest_action(self, instance):
        data = load_data()
        data["user_name"] = "زائر"
        data["is_logged_in"] = True
        save_data(data)
        self.manager.current = 'main_menu'

# ----------------- 2. القائمة الرئيسية والتحكم -----------------
class MainMenuScreen(Screen):
    def __init__(self, **kwargs):
        super().__init__(**kwargs)
        self.layout = BoxLayout(orientation='vertical', padding=20, spacing=10)
        
        self.user_label = Label(text="", font_size='18sp', size_hint_y=0.08)
        self.coins_label = Label(text="", font_size='18sp', color=(1, 0.8, 0.2, 1), size_hint_y=0.08)
        
        self.layout.add_widget(self.user_label)
        self.layout.add_widget(self.coins_label)
        
        btn_room1 = Button(text="🎤 الغرفة الصوتية 1 (الرئيسية)", background_color=(0.2, 0.6, 0.9, 1))
        btn_room1.bind(on_press=lambda x: self.enter_room("الغرفة 1"))
        
        btn_room2 = Button(text="👑 الغرفة الصوتية 2 (VIP)", background_color=(0.8, 0.2, 0.8, 1))
        btn_room2.bind(on_press=lambda x: self.enter_room("الغرفة 2"))
        
        btn_game1 = Button(text="🥩 🍓 لعبة الفواكه واللحوم", background_color=(0.9, 0.5, 0.1, 1))
        btn_game1.bind(on_press=lambda x: setattr(self.manager, 'current', 'fruit_meat_game'))

        btn_game2 = Button(text="🎡 لعبة العجلة (Roulette)", background_color=(0.2, 0.7, 0.5, 1))
        btn_game2.bind(on_press=lambda x: setattr(self.manager, 'current', 'roulette_game'))

        btn_game3 = Button(text="🚀 لعبة الصاروخ (Rocket)", background_color=(0.7, 0.3, 0.2, 1))
        btn_game3.bind(on_press=lambda x: setattr(self.manager, 'current', 'rocket_game'))

        btn_game4 = Button(text="⚔️ تحديات الميكروفون (PK)", background_color=(0.6, 0.2, 0.7, 1))
        btn_game4.bind(on_press=lambda x: setattr(self.manager, 'current', 'pk_game'))
        
        btn_admin = Button(text="⚙️ مركز التحكم الكلي (المالك)", background_color=(0.2, 0.8, 0.3, 1))
        btn_admin.bind(on_press=self.open_admin_panel)
        
        for w in [btn_room1, btn_room2, btn_game1, btn_game2, btn_game3, btn_game4, btn_admin]:
            self.layout.add_widget(w)
            
        self.add_widget(self.layout)

    def on_enter(self):
        data = load_data()
        self.user_label.text = f"👤 مرحباً: [b]{data['user_name']}[/b]"
        self.user_label.markup = True
        self.coins_label.text = f"🪙 الرصيد: {data['coins']} كوينز"

    def enter_room(self, room_name):
        room_screen = self.manager.get_screen('voice_room')
        room_screen.set_room_title(room_name)
        self.manager.current = 'voice_room'

    def open_admin_panel(self, instance):
        content = BoxLayout(orientation='vertical', padding=10, spacing=10)
        content.add_widget(Label(text="⚙️ لوحة تحكم النسخة الخاصة"))
        
        btn_add = Button(text="➕ إضافة 10,000 كوينز", background_color=(0.2, 0.7, 0.3, 1))
        btn_add.bind(on_press=self.add_coins)
        
        btn_reset = Button(text="🔄 تصفير الرصيد", background_color=(0.8, 0.2, 0.2, 1))
        btn_reset.bind(on_press=self.reset_coins)
        
        content.add_widget(btn_add)
        content.add_widget(btn_reset)
        
        self.popup = Popup(title="تحكم المالك", content=content, size_hint=(0.8, 0.4))
        self.popup.open()

    def add_coins(self, instance):
        data = load_data()
        data['coins'] += 10000
        save_data(data)
        self.coins_label.text = f"🪙 الرصيد: {data['coins']} كوينز"
        if hasattr(self, 'popup'): self.popup.dismiss()

    def reset_coins(self, instance):
        data = load_data()
        data['coins'] = 0
        save_data(data)
        self.coins_label.text = f"🪙 الرصيد: {data['coins']} كوينز"
        if hasattr(self, 'popup'): self.popup.dismiss()

# ----------------- 3. الغرفة الصوتية مع الهدايا -----------------
class VoiceRoomScreen(Screen):
    def __init__(self, **kwargs):
        super().__init__(**kwargs)
        layout = BoxLayout(orientation='vertical', padding=10, spacing=10)
        
        self.title_label = Label(text="", font_size='18sp', size_hint_y=0.1)
        layout.add_widget(self.title_label)
        
        mics = GridLayout(cols=4, spacing=10, size_hint_y=0.4)
        for i in range(1, 9):
            mics.add_widget(Button(text=f"🎙️\nعضو {i}", font_size='12sp'))
        layout.add_widget(mics)
        
        ctrls = BoxLayout(orientation='horizontal', size_hint_y=0.15, spacing=8)
        
        gift_btn = Button(text="🎁 إرسال هدية", background_color=(0.8, 0.3, 0.8, 1))
        gift_btn.bind(on_press=self.open_gifts)
        
        back_btn = Button(text="🔙 خروج", background_color=(0.7, 0.2, 0.2, 1))
        back_btn.bind(on_press=lambda x: setattr(self.manager, 'current', 'main_menu'))
        
        ctrls.add_widget(gift_btn)
        ctrls.add_widget(back_btn)
        layout.add_widget(ctrls)
        
        self.chat_log = Label(text="[النظام]: أهلاً بك في الغرفة والدردشة الصوتية!\n", size_hint_y=0.35, valign='top')
        self.chat_log.bind(size=self.chat_log.setter('text_size'))
        layout.add_widget(self.chat_log)
        
        self.add_widget(layout)

    def set_room_title(self, title):
        self.title_label.text = f"🎤 {title}"

    def open_gifts(self, instance):
        content = BoxLayout(orientation='vertical', padding=10, spacing=10)
        gifts = [("🌹 وردة", 50), ("👑 تاج", 200), ("🚀 صاروخ", 500)]
        
        for name, price in gifts:
            btn = Button(text=f"{name} ({price} كوينز)")
            btn.bind(on_press=lambda b, n=name, p=price: self.send_gift(n, p))
            content.add_widget(btn)
            
        self.popup = Popup(title="🎁 متجر الهدايا", content=content, size_hint=(0.8, 0.5))
        self.popup.open()

    def send_gift(self, name, price):
        data = load_data()
        if data['coins'] >= price:
            data['coins'] -= price
            save_data(data)
            self.chat_log.text += f"[هدية]: أرسلت {name} بقيمة {price} كوينز!\n"
            self.popup.dismiss()
        else:
            self.chat_log.text += "[خطأ]: رصيدك لا يكفي!\n"
            self.popup.dismiss()

# ----------------- 4. لعبة الفواكه واللحوم -----------------
class FruitMeatGameScreen(Screen):
    def __init__(self, **kwargs):
        super().__init__(**kwargs)
        layout = BoxLayout(orientation='vertical', padding=15, spacing=10)
        self.coins_label = Label(text="", font_size='18sp', size_hint_y=0.1)
        layout.add_widget(self.coins_label)
        
        self.result_label = Label(text="🎰 لعبة الفواكه واللحوم!\nاضغط تدوير (200 كوينز)", font_size='16sp', size_hint_y=0.3)
        layout.add_widget(self.result_label)
        
        self.items = ["🍎 تفاح", "🍉 بطيخ", "🥩 ستيك لحم", "🍗 دجاج محمر", "🍇 عنب"]
        
        btns = BoxLayout(orientation='horizontal', size_hint_y=0.2, spacing=10)
        spin_btn = Button(text="🎲 تدوير", background_color=(0.2, 0.7, 0.3, 1))
        spin_btn.bind(on_press=self.spin)
        
        back_btn = Button(text="🔙 العودة", background_color=(0.7, 0.2, 0.2, 1))
        back_btn.bind(on_press=lambda x: setattr(self.manager, 'current', 'main_menu'))
        
        btns.add_widget(spin_btn)
        btns.add_widget(back_btn)
        layout.add_widget(btns)
        self.add_widget(layout)

    def on_enter(self):
        data = load_data()
        self.coins_label.text = f"🪙 الرصيد: {data['coins']} كوينز"

    def spin(self, instance):
        data = load_data()
        if data['coins'] < 200:
            self.result_label.text = "❌ الرصيد غير كافٍ!"
            return
        data['coins'] -= 200
        win = random.choice([0, 300, 800, 1500])
        data['coins'] += win
        save_data(data)
        self.coins_label.text = f"🪙 الرصيد: {data['coins']} كوينز"
        selected = random.choice(self.items)
        if win > 0:
            self.result_label.text = f"🎉 ظهرت {selected}!\nفزت بـ {win} كوينز!"
        else:
            self.result_label.text = f"😢 ظهرت {selected}!\nلم تفز."

# ----------------- 5. لعبة العجلة (Roulette) -----------------
class RouletteGameScreen(Screen):
    def __init__(self, **kwargs):
        super().__init__(**kwargs)
        layout = BoxLayout(orientation='vertical', padding=15, spacing=10)
        self.coins_label = Label(text="", font_size='18sp', size_hint_y=0.1)
        layout.add_widget(self.coins_label)
        
        self.result_label = Label(text="🎡 لعبة عجلة الحظ الكبرى!\nرهان بـ 300 كوينز", font_size='16sp', size_hint_y=0.3)
        layout.add_widget(self.result_label)
        
        btns = BoxLayout(orientation='horizontal', size_hint_y=0.2, spacing=10)
        bet_btn = Button(text="🎰 وضع الرهان والتدوير", background_color=(0.2, 0.6, 0.8, 1))
        bet_btn.bind(on_press=self.place_bet)
        
        back_btn = Button(text="🔙 العودة", background_color=(0.7, 0.2, 0.2, 1))
        back_btn.bind(on_press=lambda x: setattr(self.manager, 'current', 'main_menu'))
        
        btns.add_widget(bet_btn)
        btns.add_widget(back_btn)
        layout.add_widget(btns)
        self.add_widget(layout)

    def on_enter(self):
        data = load_data()
        self.coins_label.text = f"🪙 الرصيد: {data['coins']} كوينز"

    def place_bet(self, instance):
        data = load_data()
        if data['coins'] < 300:
            self.result_label.text = "❌ رصيدك غير كافٍ للرهان (300 كوينز)!"
            return
        data['coins'] -= 300
        win = random.choice([0, 500, 1200, 3000])
        data['coins'] += win
        save_data(data)
        self.coins_label.text = f"🪙 الرصيد: {data['coins']} كوينز"
        if win > 0:
            self.result_label.text = f"🎉 مبروك! ربحت في العجلة مبلغ {win} كوينز!"
        else:
            self.result_label.text = "😢 حظاً أوفر, لم تحقق فوزاً في هذه الجولة."

# ----------------- 6. لعبة الصاروخ (Rocket) -----------------
class RocketGameScreen(Screen):
    def __init__(self, **kwargs):
        super().__init__(**kwargs)
        layout = BoxLayout(orientation='vertical', padding=15, spacing=10)
        self.coins_label = Label(text="", font_size='18sp', size_hint_y=0.1)
        layout.add_widget(self.coins_label)
        
        self.result_label = Label(text="🚀 لعبة الصاروخ (انطلاق المضاعف)!\nتكلفة الإطلاق: 400 كوينز", font_size='16sp', size_hint_y=0.3)
        layout.add_widget(self.result_label)
        
        btns = BoxLayout(orientation='horizontal', size_hint_y=0.2, spacing=10)
        launch_btn = Button(text="🚀 إطلاق الصاروخ", background_color=(0.8, 0.4, 0.1, 1))
        launch_btn.bind(on_press=self.launch_rocket)
        
        back_btn = Button(text="🔙 العودة", background_color=(0.7, 0.2, 0.2, 1))
        back_btn.bind(on_press=lambda x: setattr(self.manager, 'current', 'main_menu'))
        
        btns.add_widget(launch_btn)
        btns.add_widget(back_btn)
        layout.add_widget(btns)
        self.add_widget(layout)

    def on_enter(self):
        data = load_data()
        self.coins_label.text = f"🪙 الرصيد: {data['coins']} كوينز"

    def launch_rocket(self, instance):
        data = load_data()
        if data['coins'] < 400:
            self.result_label.text = "❌ الرصيد غير كافٍ لإطلاق الصاروخ!"
            return
        data['coins'] -= 400
        multiplier = random.choice([1.0, 1.5, 2.5, 5.0, 10.0])
        win = int(400 * multiplier)
        data['coins'] += win
        save_data(data)
        self.coins_label.text = f"🪙 الرصيد: {data['coins']} كوينز"
        if multiplier > 1.0:
            self.result_label.text = f"🚀 وصل الصاروخ لمضاعف x{multiplier}!\nربحت إجمالي {win} كوينز!"
        else:
            self.result_label.text = "💥 انفجر الصاروخ باكراً ولم تربح شيئاً!"

# ----------------- 7. تحديات الميكروفون والـ PK -----------------
class MicCharmPKScreen(Screen):
    def __init__(self, **kwargs):
        super().__init__(**kwargs)
        layout = BoxLayout(orientation='vertical', padding=15, spacing=10)
        self.coins_label = Label(text="", font_size='18sp', size_hint_y=0.1)
        layout.add_widget(self.coins_label)
        
        self.result_label = Label(text="⚔️ معركة الميكروفون وتحدي الـ PK!\nابدأ التحدي ونافس على الجائزة", font_size='16sp', size_hint_y=0.3)
        layout.add_widget(self.result_label)
        
        btns = BoxLayout(orientation='horizontal', size_hint_y=0.2, spacing=10)
        pk_btn = Button(text="⚔️ بدء تحدي الـ PK", background_color=(0.9, 0.2, 0.3, 1))
        pk_btn.bind(on_press=self.start_pk)
        
        back_btn = Button(text="🔙 العودة", background_color=(0.7, 0.2, 0.2, 1))
        back_btn.bind(on_press=lambda x: setattr(self.manager, 'current', 'main_menu'))
        
        btns.add_widget(pk_btn)
        btns.add_widget(back_btn)
        layout.add_widget(btns)
        self.add_widget(layout)

    def on_enter(self):
        data = load_data()
        self.coins_label.text = f"🪙 الرصيد: {data['coins']} كوينز"

    def start_pk(self, instance):
        data = load_data()
        reward = random.choice([1000, 2500, 5000])
        data['coins'] += reward
        save_data(data)
        self.coins_label.text = f"🪙 الرصيد: {data['coins']} كوينز"
        self.result_label.text = f"🏆 انتصرت في معركة الـ PK بفضل تفاعل الغرفة!\nحصلت على مكافأة {reward} كوينز!"

# ----------------- المشغل العام -----------------
class AppManager(App):
    def build(self):
        sm = ScreenManager()
        sm.add_widget(LoginScreen(name='login'))
        sm.add_widget(MainMenuScreen(name='main_menu'))
        sm.add_widget(VoiceRoomScreen(name='voice_room'))
        sm.add_widget(FruitMeatGameScreen(name='fruit_meat_game'))
        sm.add_widget(RouletteGameScreen(name='roulette_game'))
        sm.add_widget(RocketGameScreen(name='rocket_game'))
        sm.add_widget(MicCharmPKScreen(name='pk_game'))
        return sm

if __name__ == '__main__':
    AppManager().run()

